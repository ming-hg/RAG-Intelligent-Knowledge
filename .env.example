# 复制成 .env 后按需修改；.env 已在 .gitignore 里，不会被提交。
# 这里的默认值就是本机实测环境，直接 cp .env.example .env 也能跑起来。
#
# 信任边界：整套系统只待在局域网。LM Studio 不开鉴权（LM_STUDIO_API_KEY 只是占位串），
# 前提是 1234 端口不做公网映射。要暴露到局域网之外，先给 rag-api 前面加反向代理与鉴权。

# ── rag-api ───────────────────────────────────────────────
RAG_API_PORT=8080
RAG_STORAGE_DIR=./storage
# 应用日志，logback 滚动 + UTF-8。默认相对启动时的当前目录，deploy/start.sh 在仓库根跑，
# 所以默认就落在 deploy/logs/rag-api.log。IDE 里直接 run 的话建议给绝对路径，免得在模块目录下长出副本。
# RAG_LOG_FILE=deploy/logs/rag-api.log

# ── deploy/*.sh ───────────────────────────────────────────
RAG_WEB_PORT=5173                  # start.sh 起 vite 的端口，被占了改这里就行
# RAG_API=http://localhost:8080    # smoke.sh 打的后端地址；不写就用上面的 RAG_API_PORT

# ── PostgreSQL（deploy/docker-compose.yml 里的容器读同一份） ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_knowledge
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev

# ── LM Studio ─────────────────────────────────────────────
# 本机部署写 http://localhost:1234/v1；跨机器写 http://<对方局域网IP>:1234/v1，
# 并要在对方那台 LM Studio → Local Server 勾选 Serve on Local Network 且放行防火墙入站 TCP 1234。
LM_STUDIO_BASE_URL=http://192.168.1.61:1234/v1
LM_STUDIO_API_KEY=lm-studio
# 模型名必须与 /v1/models 返回的 id 逐字符一致：LM Studio 对认不出的名字不报错，
# 会用当前已加载的模型应答，静默换模型比报错更难查。
LM_STUDIO_CHAT_MODEL=qwen2.5-vl-7b-instruct
LM_STUDIO_EMBEDDING_MODEL=text-embedding-bge-base-zh-v1.5

# ── embedding ─────────────────────────────────────────────
# 维度是 schema 的一部分：改了它必须重建库或全量重算，否则启动校验直接报错。
RAG_EMBEDDING_DIM=768
RAG_EMBEDDING_BATCH_SIZE=16

# ── 检索与上下文预算 ───────────────────────────────────────
RAG_RETRIEVAL_MODE=hybrid
RAG_RETRIEVAL_TOP_K=6
# 必须等于 LM Studio 里该模型加载后的真实 context，两边只改一边会出现
# 「引用编号在但模型没看到」或「装不下的命中一直不为 0」。
RAG_LLM_N_CTX=4096

# ── 入库 ──────────────────────────────────────────────────
RAG_INGEST_WORKER=true
# 单机单卡：调大不会更快，只会让 embedding 排队并撞超时
RAG_INGEST_CONCURRENCY=1

# ── 归档包 ────────────────────────────────────────────────
# 带向量的包比正文大一个量级，与单篇文档上限（rag.ingest.max-file-size-mb=100）各管各的
RAG_ARCHIVE_MAX_IMPORT_MB=512

# ── rag-web（Vite 代理目标） ──────────────────────────────
VITE_API_TARGET=http://localhost:8080
