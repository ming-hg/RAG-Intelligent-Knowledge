node_modules

# Java
target/
*.class
*.jar.original

# 运行期数据（不入库）
storage/
rag-api/storage/

# zhparser 构建用的上游源码包（约 14MB）：跑 sh deploy/pg/fetch-vendor.sh 取，带 sha256 校验
deploy/pg/vendor/

# 本地环境
deploy/.env
.env
*.log
# deploy/start.sh 的运行期产物：rag-api.out 是 stdout 落盘，*.pid 是进程号
*.out
*.pid
# logback 按天滚出来的归档包是 .gz，上面的 *.log 盖不住它
deploy/logs/*.gz
.idea/
.vscode/
*.iml
